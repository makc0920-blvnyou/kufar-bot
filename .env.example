BOT_TOKEN=your_bot_token

# Админы (через запятую)
ADMIN_IDS=475027162

# Neon PostgreSQL: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require

# Если DATABASE_URL не задан — используется локальный SQLite (data/kufar.db)

# --- Планировщик ---
CHECK_LOOP_SECONDS=15
MIN_KUFAR_INTERVAL_SECONDS=15
KUFAR_CACHE_TTL_SECONDS=30
DEFAULT_CHECK_INTERVAL_SECONDS=300

# --- Парсер ---
KEYWORDS=iPhone
MAX_ITEMS_PER_CHECK=30

# --- Доступ ---
ALLOW_SELF_REGISTER=true
DEFAULT_ACCESS_LEVEL=free

# --- Rate limit команд ---
COMMAND_RATE_LIMIT_PER_MIN=10

# --- Legacy (резервные чаты, не обязательны) ---
# CHAT_ID=475027162
# ADDITIONAL_CHAT_IDS=
